<!DOCTYPE html>
<html lang="ru" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HabitPulse — Панель отслеживания привычек</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'system-ui', 'sans-serif'],
                    },
                    colors: {
                        darkBg: '#0b0f19',
                        darkCard: '#111827',
                        darkBorder: '#1f2937'
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            transition: background-color 0.3s ease, color 0.3s ease;
        }
        /* Кастомный скроллбар */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(156, 163, 175, 0.3);
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(156, 163, 175, 0.5);
        }
        /* Анимация чекбокса и огонька */
        @keyframes pop {
            0% { transform: scale(0.85); }
            50% { transform: scale(1.12); }
            100% { transform: scale(1); }
        }
        .animate-pop {
            animation: pop 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }
        @keyframes pulse-glow {
            0%, 100% { filter: drop-shadow(0 0 4px rgba(249, 115, 22, 0.5)); }
            50% { filter: drop-shadow(0 0 10px rgba(249, 115, 22, 0.9)); }
        }
        .flame-glow {
            animation: pulse-glow 2s infinite;
        }
        .glass-panel {
            backdrop-filter: blur(12px);
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-900 dark:bg-darkBg dark:text-slate-100 min-h-screen selection:bg-emerald-500 selection:text-white pb-12">

    <!-- Фоновые декоративные градиентные пятна -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute -top-40 -left-40 w-96 h-96 bg-emerald-500/10 dark:bg-emerald-500/10 rounded-full blur-3xl"></div>
        <div class="absolute top-1/4 -right-40 w-96 h-96 bg-violet-500/10 dark:bg-violet-500/10 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-40 left-1/3 w-96 h-96 bg-blue-500/10 dark:bg-blue-500/10 rounded-full blur-3xl"></div>
    </div>

    <!-- Главный контейнер -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
        
        <!-- Шапка (Header) -->
        <header class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 pb-6 mb-6 border-b border-slate-200 dark:border-slate-800/80">
            <div class="flex items-center gap-3.5">
                <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-emerald-400 via-teal-500 to-blue-600 flex items-center justify-center shadow-lg shadow-emerald-500/20 text-white">
                    <i data-lucide="flame" class="w-7 h-7"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2.5">
                        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight bg-gradient-to-r from-slate-900 via-slate-700 to-slate-900 dark:from-white dark:via-slate-200 dark:to-slate-400 bg-clip-text text-transparent">
                            HabitPulse
                        </h1>
                        <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                            PRO Трекер
                        </span>
                    </div>
                    <p id="currentDateDisplay" class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-0.5">
                        Среда, 14 октября • Неделя продуктивности
                    </p>
                </div>
            </div>

            <!-- Кнопки управления -->
            <div class="flex flex-wrap items-center gap-2.5">
                <!-- Переключатель активного дня ("Сегодня") для удобства тестирования -->
                <div class="flex items-center bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-1.5 shadow-sm">
                    <span class="text-xs text-slate-400 dark:text-slate-500 mr-2 font-medium">Активный день:</span>
                    <select id="activeDaySelect" class="bg-transparent text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200 focus:outline-none cursor-pointer">
                        <option value="0">Понедельник</option>
                        <option value="1">Вторник</option>
                        <option value="2">Среда</option>
                        <option value="3">Четверг</option>
                        <option value="4">Пятница</option>
                        <option value="5">Суббота</option>
                        <option value="6">Воскресенье</option>
                    </select>
                </div>

                <!-- Кнопка добавления привычки -->
                <button id="openAddModalBtn" class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 text-white font-semibold text-sm shadow-lg shadow-emerald-500/20 transition transform active:scale-95">
                    <i data-lucide="plus" class="w-4 h-4"></i>
                    <span>Новая привычка</span>
                </button>

                <!-- Кнопка сброса к демо-данным -->
                <button id="resetDemoBtn" title="Сбросить к демо-данным" class="flex items-center gap-1.5 px-3.5 py-2.5 rounded-xl bg-white dark:bg-slate-900 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-800 text-sm font-medium transition shadow-sm">
                    <i data-lucide="rotate-ccw" class="w-4 h-4 text-slate-500 dark:text-slate-400"></i>
                    <span class="hidden sm:inline">Демо</span>
                </button>

                <!-- Переключатель темы -->
                <button id="themeToggleBtn" aria-label="Переключить тему" class="p-2.5 rounded-xl bg-white dark:bg-slate-900 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-800 transition shadow-sm">
                    <i data-lucide="sun" class="w-5 h-5 hidden dark:block text-amber-400"></i>
                    <i data-lucide="moon" class="w-5 h-5 block dark:hidden text-slate-700"></i>
                </button>
            </div>
        </header>

        <!-- Верхние сводные карточки (KPI Summary) -->
        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
            <!-- Карточка 1: Выполнено сегодня -->
            <div class="bg-white dark:bg-darkCard border border-slate-200/80 dark:border-slate-800/90 rounded-2xl p-5 shadow-sm relative overflow-hidden">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">Цели на сегодня</p>
                        <div class="flex items-baseline gap-2 mt-2">
                            <h3 id="statTodayCount" class="text-3xl font-extrabold text-slate-900 dark:text-white">0/0</h3>
                            <span id="statTodayPercent" class="text-sm font-bold text-emerald-500">0%</span>
                        </div>
                    </div>
                    <div class="p-3 rounded-xl bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">
                        <i data-lucide="check-circle-2" class="w-6 h-6"></i>
                    </div>
                </div>
                <!-- Прогресс бар внутри карточки -->
                <div class="w-full h-2 bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden mt-4">
                    <div id="statTodayBar" class="h-full bg-gradient-to-r from-emerald-500 to-teal-400 rounded-full transition-all duration-500" style="width: 0%"></div>
                </div>
            </div>

            <!-- Карточка 2: Продуктивность за неделю -->
            <div class="bg-white dark:bg-darkCard border border-slate-200/80 dark:border-slate-800/90 rounded-2xl p-5 shadow-sm">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">Эффективность недели</p>
                        <div class="flex items-baseline gap-2 mt-2">
                            <h3 id="statWeekPercent" class="text-3xl font-extrabold text-slate-900 dark:text-white">0%</h3>
                            <span id="statWeekTotal" class="text-xs font-medium text-slate-400 dark:text-slate-500">0 из 0 отм.</span>
                        </div>
                    </div>
                    <div class="p-3 rounded-xl bg-violet-500/10 text-violet-500 border border-violet-500/20">
                        <i data-lucide="trending-up" class="w-6 h-6"></i>
                    </div>
                </div>
                <div class="w-full h-2 bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden mt-4">
                    <div id="statWeekBar" class="h-full bg-gradient-to-r from-violet-500 to-purple-400 rounded-full transition-all duration-500" style="width: 0%"></div>
                </div>
            </div>

            <!-- Карточка 3: Лучшая текущая серия -->
            <div class="bg-white dark:bg-darkCard border border-slate-200/80 dark:border-slate-800/90 rounded-2xl p-5 shadow-sm">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">Максимальная серия</p>
                        <div class="flex items-baseline gap-2 mt-2">
                            <h3 id="statMaxStreak" class="text-3xl font-extrabold text-slate-900 dark:text-white">0 дн.</h3>
                            <span class="text-base">🔥</span>
                        </div>
                    </div>
                    <div class="p-3 rounded-xl bg-amber-500/10 text-amber-500 border border-amber-500/20">
                        <i data-lucide="zap" class="w-6 h-6"></i>
                    </div>
                </div>
                <p id="statMaxStreakHabit" class="text-xs text-slate-500 dark:text-slate-400 mt-3 truncate">
                    Лидер: —
                </p>
            </div>

            <!-- Карточка 4: Идеальные дни -->
            <div class="bg-white dark:bg-darkCard border border-slate-200/80 dark:border-slate-800/90 rounded-2xl p-5 shadow-sm">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">Лучший день недели</p>
                        <div class="flex items-baseline gap-2 mt-2">
                            <h3 id="statBestDay" class="text-2xl font-extrabold text-slate-900 dark:text-white">—</h3>
                        </div>
                    </div>
                    <div class="p-3 rounded-xl bg-blue-500/10 text-blue-500 border border-blue-500/20">
                        <i data-lucide="award" class="w-6 h-6"></i>
                    </div>
                </div>
                <p id="statPerfectDaysCount" class="text-xs text-slate-500 dark:text-slate-400 mt-3">
                    100% закрытых дней: 0 из 7
                </p>
            </div>
        </section>

        <!-- Основная сетка: Цели на сегодня (Слева) + Недельная матрица (Справа) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-6">
            
            <!-- БЛОК 1: ЦЕЛИ НА СЕГОДНЯ (5 колонок на больших экранах) -->
            <section class="lg:col-span-5 bg-white dark:bg-darkCard border border-slate-200/80 dark:border-slate-800/90 rounded-2xl p-5 sm:p-6 shadow-sm flex flex-col justify-between">
                <div>
                    <!-- Заголовок секции -->
                    <div class="flex items-center justify-between mb-4">
                        <div>
                            <div class="flex items-center gap-2">
                                <h2 class="text-lg font-bold text-slate-900 dark:text-white">Цели на сегодня</h2>
                                <span id="todayDayBadge" class="text-xs font-semibold px-2.5 py-0.5 rounded-md bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20">
                                    Ср
                                </span>
                            </div>
                            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Отмечайте выполненные задачи за выбранный день</p>
                        </div>

                        <button id="markAllTodayBtn" class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 hover:underline flex items-center gap-1">
                            <i data-lucide="check-check" class="w-3.5 h-3.5"></i>
                            <span>Отметить все</span>
                        </button>
                    </div>

                    <!-- Прогресс-бар выполнения за текущий день -->
                    <div class="mb-5 p-4 rounded-xl bg-slate-50 dark:bg-slate-900/90 border border-slate-200/60 dark:border-slate-800">
                        <div class="flex items-center justify-between text-xs font-semibold mb-2">
                            <span class="text-slate-600 dark:text-slate-300">Дневной прогресс</span>
                            <span id="dailyProgressText" class="text-emerald-600 dark:text-emerald-400 font-bold">0% выполнено</span>
                        </div>
                        <div class="w-full h-3 bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden p-0.5">
                            <div id="dailyProgressBar" class="h-full rounded-full bg-gradient-to-r from-emerald-500 via-teal-400 to-blue-500 transition-all duration-500" style="width: 0%"></div>
                        </div>
                        <p id="dailyMotivationalQuote" class="text-[11px] text-slate-500 dark:text-slate-400 mt-2">
                            Маленькие ежедневные шаги приводят к большим результатам!
                        </p>
                    </div>

                    <!-- Список привычек на сегодня -->
                    <div id="todayHabitsList" class="space-y-2.5 max-h-[420px] overflow-y-auto pr-1">
                        <!-- Заполняется через JS -->
                    </div>
                </div>

                <!-- Нижняя подсказка -->
                <div class="mt-5 pt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs text-slate-400 dark:text-slate-500">
                    <span>🔥 Серия считается до выбранного активного дня</span>
                    <span id="totalHabitsCount">Всего: 5</span>
                </div>
            </section>

            <!-- БЛОК 2: ТАБЛИЦА / СЕТКА ЗА НЕДЕЛЮ (7 колонок на больших экранах) -->
            <section class="lg:col-span-7 bg-white dark:bg-darkCard border border-slate-200/80 dark:border-slate-800/90 rounded-2xl p-5 sm:p-6 shadow-sm flex flex-col justify-between">
                <div>
                    <!-- Заголовок и фильтр категорий -->
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5">
                        <div>
                            <h2 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
                                <span>Матрица недели (Пн – Вс)</span>
                            </h2>
                            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                                Нажмите на любую ячейку дня, чтобы отметить или снять выполнение
                            </p>
                        </div>

                        <!-- Фильтр по категориям -->
                        <div class="flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0" id="categoryFilterBar">
                            <button data-cat="all" class="cat-btn px-2.5 py-1 rounded-lg text-xs font-semibold bg-emerald-500 text-white transition">Все</button>
                            <button data-cat="Спорт" class="cat-btn px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition">Спорт</button>
                            <button data-cat="Обучение" class="cat-btn px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition">Обучение</button>
                            <button data-cat="Здоровье" class="cat-btn px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition">Здоровье</button>
                        </div>
                    </div>

                    <!-- Таблица за неделю -->
                    <div class="overflow-x-auto -mx-2 px-2">
                        <table class="w-full text-left border-collapse min-w-[540px]">
                            <thead>
                                <tr id="weeklyTableHeader" class="border-b border-slate-200 dark:border-slate-800 text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase">
                                    <!-- Заполняется через JS -->
                                </tr>
                            </thead>
                            <tbody id="weeklyTableBody" class="divide-y divide-slate-100 dark:divide-slate-800/70 text-sm">
                                <!-- Заполняется через JS -->
                            </tbody>
                            <tfoot>
                                <tr id="weeklyTableFooter" class="border-t border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-900/50 text-xs font-semibold">
                                    <!-- Итоги по дням недели заполняются через JS -->
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <!-- Легенда таблицы -->
                <div class="mt-5 pt-4 border-t border-slate-100 dark:border-slate-800/80 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-400 dark:text-slate-500">
                    <div class="flex items-center gap-4">
                        <span class="flex items-center gap-1.5">
                            <span class="w-3 h-3 rounded bg-emerald-500 inline-block"></span> Выполнено
                        </span>
                        <span class="flex items-center gap-1.5">
                            <span class="w-3 h-3 rounded border border-slate-300 dark:border-slate-700 inline-block"></span> Пропуск
                        </span>
                        <span class="flex items-center gap-1.5">
                            <span class="w-3 h-3 rounded ring-2 ring-blue-500 inline-block"></span> Выбранный день («Сегодня»)
                        </span>
                    </div>
                    <span>Автосохранение включено</span>
                </div>
            </section>
        </div>

        <!-- БЛОК 3: ВИЗУАЛИЗАЦИЯ И ГРАФИКИ (2 колонки) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            
            <!-- ГРАФИК 1: График продуктивности за неделю (7 колонок) -->
            <section class="lg:col-span-7 bg-white dark:bg-darkCard border border-slate-200/80 dark:border-slate-800/90 rounded-2xl p-5 sm:p-6 shadow-sm">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-6">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                            <h2 class="text-lg font-bold text-slate-900 dark:text-white">График продуктивности за неделю</h2>
                        </div>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                            Динамика выполнения привычек по дням недели (Пн – Вс)
                        </p>
                    </div>

                    <!-- Переключатель типа графика: Плавная линия / Столбцы -->
                    <div class="inline-flex rounded-xl p-1 bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 self-start">
                        <button id="chartModeAreaBtn" class="px-3 py-1 rounded-lg text-xs font-semibold bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-sm transition">
                            Волна
                        </button>
                        <button id="chartModeBarBtn" class="px-3 py-1 rounded-lg text-xs font-semibold text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition">
                            Столбцы
                        </button>
                    </div>
                </div>

                <!-- Контейнер для SVG графика продуктивности -->
                <div id="weeklyProductivityChart" class="w-full h-64 relative select-none">
                    <!-- Отрисовывается динамически через JS SVG -->
                </div>
            </section>

            <!-- ГРАФИК 2: График серий достижений (5 колонок) -->
            <section class="lg:col-span-5 bg-white dark:bg-darkCard border border-slate-200/80 dark:border-slate-800/90 rounded-2xl p-5 sm:p-6 shadow-sm flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-4">
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="w-2.5 h-2.5 rounded-full bg-violet-500"></span>
                                <h2 class="text-lg font-bold text-slate-900 dark:text-white">График серий достижений</h2>
                            </div>
                            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                                Сравнение текущей серии 🔥 и рекорда за неделю 🏆
                            </p>
                        </div>
                    </div>

                    <!-- Легенда сравнения серий -->
                    <div class="flex items-center gap-4 mb-4 text-xs font-medium">
                        <div class="flex items-center gap-1.5">
                            <span class="w-3 h-3 rounded-sm bg-gradient-to-r from-emerald-500 to-teal-400 inline-block"></span>
                            <span class="text-slate-600 dark:text-slate-300">Текущая серия (до сегодня)</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <span class="w-3 h-3 rounded-sm bg-gradient-to-r from-violet-500 to-indigo-500 inline-block"></span>
                            <span class="text-slate-600 dark:text-slate-300">Лучшая серия за неделю</span>
                        </div>
                    </div>

                    <!-- Контейнер для диаграммы серий -->
                    <div id="streaksComparisonChart" class="space-y-4 max-h-[250px] overflow-y-auto pr-1">
                        <!-- Заполняется через JS -->
                    </div>
                </div>

                <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs text-slate-400 dark:text-slate-500">
                    <span>Максимум за неделю: 7 дней подряд</span>
                    <span id="overallConsistencyBadge" class="font-semibold text-violet-500">Стабильность: высокая</span>
                </div>
            </section>

        </div>
    </div>

